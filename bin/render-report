HTML
  if [[ -n "$kind" ]]; then printf '<body data-kind="%s">\n' "$kind"; else echo '<body>'; fi
  if (( stack )); then
    for f in "$@"; do
      i=$((i + 1))
      name="$(basename "$f" .md)"
      if (( i == 1 )); then
        id=stack label=Stack
      elif [[ "$name" =~ ^[0-9]+$ ]]; then
        id="$name" label="#$name"
      else
        id="$(printf %s "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
        label="$(printf %s "$name" | html_escape)"
      fi
      printf '<script type="text/plain" class="md" data-tab="%s" data-label="%s">' "$id" "$label"
      embed "$f"
      printf '</script>\n'
    done
  else
    echo '<main id="page"></main>'
    printf '<script type="text/plain" id="md">'
    embed "$1"
    printf '</script>\n'
  fi
  if [[ -n "$help" ]]; then
    printf '<script type="text/plain" id="help">'
    embed "$help"
    printf '</script>\n'
    # The plugin's own pictures, not report content: they go in verbatim.
    for pic in "$plugin_root/references/$kind-help"/*.svg; do
      [[ -f "$pic" ]] || continue
      printf '<template id="help-pic-%s">' "$(basename "$pic" .svg)"
      cat "$pic"
      printf '</template>\n'
    done
  fi
  cat <<'HTML'
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script>
(function () {
  function text(node) {
    var b64 = node.textContent.trim();
    return new TextDecoder('utf-8').decode(Uint8Array.from(atob(b64), function (c) { return c.charCodeAt(0); }));
  }
  function decode(id) {
    var node = document.getElementById(id);
    return node ? text(node) : '';
  }
  var help = decode('help');
  var kind = document.body.getAttribute('data-kind') || '';
  // One report, or on a stack page one tab per report, each in a panel of
  // its own: { id, label, md, page, panel }.
  var single = document.getElementById('md');
  var tabs = single ? [{ md: text(single), page: document.getElementById('page') }]
    : Array.prototype.map.call(document.querySelectorAll('script.md'), function (s) {
      var panel = document.createElement('section'), page = document.createElement('main');
      panel.className = 'tab-panel';
      panel.id = s.getAttribute('data-tab');
      panel.setAttribute('role', 'tabpanel');
      page.className = 'page';
      panel.appendChild(page);
      document.body.appendChild(panel);
      return { id: panel.id, label: s.getAttribute('data-label'), md: text(s), page: page, panel: panel };
    });

  if (!window.marked) {
    tabs.forEach(function (t) {
      var pre = document.createElement('pre');
      pre.textContent = t.md;
      if (t.label) t.page.appendChild(document.createElement('h2')).textContent = t.label;
      t.page.appendChild(pre);
    });
    return;
  }

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  // Reports quote PR content: raw HTML in them is data, shown as text, and
  // an image shows as its alt text, so opening the page fetches nothing.
  marked.use({ renderer: {
    html: function (h) { return escapeHtml(h); },
    image: function (href, title, text) { return '[image: ' + (text || escapeHtml(href)) + ']'; }
  } });
  // Links only to the web, never javascript: or data: URLs.
  function render(root, text) {
    root.innerHTML = marked.parse(text);
    root.querySelectorAll('a[href]').forEach(function (a) {
      if (!/^(https?:|mailto:|#)/i.test(a.getAttribute('href'))) a.removeAttribute('href');
    });
  }

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  }
  function all(root, sel) {
    return Array.prototype.slice.call(root.querySelectorAll(sel));
  }
  // A heading's id: "Ship or block" is ship-or-block.
  function slug(text) {
    return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }
  // The node an element opens with: not blank text, a tag or a pill, and
  // looking inside the <p> of a loose list item.
  function first(node) {
    var n = node.firstChild;
    while (n && (n.nodeType === 3 ? !n.nodeValue.trim() : /\b(tag|pill)\b/.test(n.className))) n = n.nextSibling;
    return n && n.nodeName === 'P' ? first(n) : n;
  }
  // A header line is plain text, or links only its PR number: "[#12](url)".
  function plain(node, num) {
    var a = node.firstElementChild;
    return !a || (node.children.length === 1 && a.tagName === 'A' && a.textContent === num);
  }
  // "#12 title" as a muted number, a link to the PR when the line had one,
  // and the title.
  function numbered(h1, from, num, text) {
    var a = from.querySelector('a'), href = a && a.getAttribute('href');
    var n = el(href ? 'a' : 'span', 'num', num);
    if (href) n.href = href;
    h1.textContent = ' ' + text;
    h1.insertBefore(n, h1.firstChild);
  }

  // Header band: the kind of report, the title, the line under it, then the
  // verdict (triage) or the summary (review guide). Other shapes stay put.
  function header(page) {
    var top = el('div', 'wrap');
    var lead = page.firstElementChild;
    if (lead && lead.tagName === 'P' && /^Triage:/.test(lead.textContent)) {
      // Verdict line: "Triage: x · impact y · ..." becomes tiles.
      var badges = el('div', 'badges');
      lead.textContent.split(' · ').forEach(function (part) {
        var colour = /\b(high|needs-changes|failed)\b/.test(part) ? 'red'
          : /\b(medium|needs-human)\b/.test(part) ? 'amber'
          : /\b(low|none|ready)/.test(part) ? 'green' : '';
        var kv = /^(\w+):?\s+(.+)$/.exec(part.trim()) || ['', '', part.trim()];
        var b = el('span', 'badge ' + colour);
        if (kv[1]) b.appendChild(el('span', 'k', kv[1]));
        b.appendChild(el('b', '', kv[2]));
        badges.appendChild(b);
      });
      var meta = lead.nextElementSibling;
      var stack = meta && meta.tagName === 'P' && !meta.children.length && /^Stack (?:of )?(#\d+), (.+)$/.exec(meta.textContent);
      lead.remove();
      top.appendChild(el('div', 'eyebrow', stack ? 'Stack triage' : 'PR triage'));
      if (stack) {
        top.appendChild(el('h1', '', 'Stack ' + stack[1]));
        meta.textContent = stack[2];
        meta.className = 'meta';
        top.appendChild(meta);
      } else if (meta && meta.tagName === 'P' && /^PR #\d+/.test(meta.textContent)) {
        var pr = /^PR (#\d+) "(.+)" \(([^)]*)\), (.+)$/.exec(meta.textContent);
        if (pr && plain(meta, pr[1])) {
          var h1 = el('h1');
          numbered(h1, meta, pr[1], pr[2]);
          top.appendChild(h1);
          meta.textContent = pr[3] + ', ' + pr[4];
        }
        meta.className = 'meta';
        top.appendChild(meta);
      }
      top.appendChild(badges);
    } else if (lead && lead.tagName === 'H1') {
      if (/^Review guide/.test(document.title)) top.appendChild(el('div', 'eyebrow', 'Review guide'));
      var text = lead.textContent, num = /^(#\d+) (.+)$/.exec(text), cut = text.indexOf(' · ');
      if (num && plain(lead, num[1])) {
        numbered(lead, lead, num[1], num[2]);
      } else if (!lead.children.length && cut > 0) {
        lead.textContent = text.slice(0, cut);
        lead.appendChild(el('span', 'sub', text.slice(cut + 3)));
      }
      top.appendChild(lead);
      var line = page.firstElementChild, quote = line && line.nextElementSibling;
      if (line && line.tagName === 'P' && / · /.test(line.textContent) && quote && quote.tagName === 'BLOCKQUOTE') {
        line.className = 'meta';
        quote.classList.add('card');
        top.appendChild(line);
        top.appendChild(quote);
      }
    }
    return top;
  }

  // ⚑ and 🔒 become tags, a slice reference, "(#12)" or "(#12, used by
  // #13)", a chip, and a decision's "Agree, or push back on:" starts a line.
  var mark = /(⚑|🔒|\(#\d+(?:, used by #\d+)?\)|Agree, or push back on:)/;
  function marks(root) {
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    var texts = [];
    while (walker.nextNode()) {
      var node = walker.currentNode;
      if (mark.test(node.nodeValue) && !node.parentNode.closest('code, pre')) texts.push(node);
    }
    texts.forEach(function (node) {
      var frag = document.createDocumentFragment();
      node.nodeValue.split(mark).forEach(function (piece, i) {
        if (i % 2 === 0) {
          if (piece) frag.appendChild(document.createTextNode(piece));
        } else if (piece.charAt(0) === '(') {
          frag.appendChild(el('span', 'chip', piece.slice(1, -1)));
        } else if (piece.charAt(0) === 'A') {
          frag.appendChild(el('b', 'pushback', piece));
        } else {
          var t = el('span', piece === '⚑' ? 'tag flag' : 'tag lock', piece);
          t.title = piece === '⚑' ? 'Needs judgement' : 'Permanent after merge';
          frag.appendChild(t);
        }
      });
      node.replaceWith(frag);
    });
  }

  // The report's own shapes, styled the same in the report and in the help's
  // examples.
  function dress(root) {
    marks(root);

    // Put a pill in place of a bold label, dropping the space after it.
    function swap(s, pill) {
      var t = s.nextSibling;
      if (t && t.nodeType === 3) t.nodeValue = t.nodeValue.replace(/^\s+/, '');
      s.replaceWith(pill);
    }

    // Findings: a Must-fix or Should-fix item gets a stripe and a pill.
    all(root, 'li').forEach(function (li) {
      var s = first(li);
      var m = s && s.nodeName === 'STRONG' && /^(Must|Should)-fix:\s*/.exec(s.textContent);
      if (!m) return;
      li.classList.add(m[1] === 'Must' ? 'must' : 'should');
      var t = s.firstChild;
      if (t.nodeType === 3 && t.nodeValue.indexOf(m[0]) === 0) {
        t.nodeValue = t.nodeValue.slice(m[0].length);
        var pill = el('span', 'pill ' + (m[1] === 'Must' ? 'red' : 'amber'), m[1] + '-fix');
        if (s.textContent.trim()) s.parentNode.insertBefore(pill, s);
        else swap(s, pill);
      }
    });

    // Ship or block, and a triage's Owner check: an item that opens with a
    // bold call gets a pill instead. A loose item's <p> is unwrapped, so it
    // still lays out as a row.
    var sections = {
      'Ship or block': { 'Block': 'red', 'Ship unless': 'amber', 'After merge': 'amber', 'Ship': 'green' },
      'Owner check': { 'Understood': 'green', 'Gap': 'amber' }
    };
    all(root, 'h2').forEach(function (h2) {
      var calls = sections[h2.textContent.split(' — ')[0].trim()];
      if (!calls) return;
      for (var n = h2.nextElementSibling; n && n.tagName !== 'H2'; n = n.nextElementSibling) {
        if (n.tagName === 'UL' || n.tagName === 'OL') Array.prototype.forEach.call(n.children, function (li) {
          var s = first(li), m = s && s.nodeName === 'STRONG' && /^(.+?):\s*$/.exec(s.textContent);
          if (!m || !Object.prototype.hasOwnProperty.call(calls, m[1])) return;
          var p = s.parentNode;
          li.classList.add('call');
          swap(s, el('span', 'pill ' + calls[m[1]], m[1]));
          if (p.nodeName === 'P' && li.children.length === 1) {
            while (p.firstChild) li.insertBefore(p.firstChild, p);
            p.remove();
          }
        });
      }
    });

    // A list of "**Label:** value" items becomes a label/value grid; so does
    // a list of plain "Label: value" items nested in an item (a finding's
    // Trigger/Effect/Evidence/Fix), never a top-level prose list.
    all(root, 'ul').forEach(function (ul) {
      var nested = ul.parentNode.nodeName === 'LI';
      var items = Array.prototype.slice.call(ul.children);
      var labels = items.map(function (li) {
        var n = first(li);
        if (n && n.nodeName === 'STRONG') return /\S:$/.test(n.textContent.trim()) ? n : null;
        return nested && !li.matches('.must, .should') && n && n.nodeType === 3 && /^\s*[A-Z][\w-]*( [\w-]+){0,2}: /.test(n.nodeValue) ? n : null;
      });
      if (!items.length || labels.indexOf(null) >= 0) return;
      var dl = el('dl', 'fields');
      items.forEach(function (li, i) {
        var n = labels[i], dt, dd = el('dd');
        if (n.nodeType === 3) {
          var m = /^\s*([^:]+):\s*/.exec(n.nodeValue);
          dt = el('dt', '', m[1]);
          n.nodeValue = n.nodeValue.slice(m[0].length);
        } else {
          dt = el('dt', '', n.textContent.trim().slice(0, -1));
          n.remove();
        }
        while (li.firstChild) dd.appendChild(li.firstChild);
        if (/^Ask the author$/i.test(dt.textContent)) dt.className = dd.className = 'ask';
        dl.appendChild(dt);
        dl.appendChild(dd);
      });
      ul.replaceWith(dl);
    });

    // A heading over a label/value grid is a card: a route stop.
    all(root, 'h3').forEach(function (h3) {
      var dl = h3.nextElementSibling;
      if (!dl || dl.tagName !== 'DL') return;
      var card = el('section', 'stop'), t = h3.firstChild;
      var n = t && t.nodeType === 3 && /^\s*(\d+)\.\s*/.exec(t.nodeValue);
      if (n) {
        t.nodeValue = t.nodeValue.slice(n[0].length);
        h3.insertBefore(el('span', 'n', n[1]), t);
      }
      h3.replaceWith(card);
      card.appendChild(h3);
      card.appendChild(dl);
    });

    // A numbered list whose items open in bold, or with a call's pill, is a
    // list of cards.
    all(root, 'ol').forEach(function (ol) {
      var items = Array.prototype.slice.call(ol.children);
      if (items.length && items.every(function (li) { return li.matches('.must, .should, .call') || (first(li) || {}).nodeName === 'STRONG'; })) {
        ol.classList.add('cards');
      }
    });

    // A top-level list of "**key** value" or "key — value" items becomes rows.
    all(root, ':scope > ul').forEach(function (ul) {
      var items = Array.prototype.slice.call(ul.children);
      var cuts = items.map(function (li) {
        var nodes = Array.prototype.slice.call(li.childNodes), s = first(li);
        if (nodes.some(function (n) { return n.nodeType === 1 && !/^(CODE|STRONG|EM|A|SPAN|DEL|BR)$/.test(n.tagName); })) return null;
        if (s && s.nodeName === 'STRONG' && s.parentNode === li) return s;
        return nodes.filter(function (n) { return n.nodeType === 3 && n.nodeValue.indexOf(' — ') >= 0; })[0] || null;
      });
      if (!items.length || cuts.indexOf(null) >= 0) return;
      ul.classList.add('rows');
      items.forEach(function (li, i) {
        var k = el('div', 'k'), v = el('div', 'v'), cut = cuts[i];
        while (li.firstChild !== cut) k.appendChild(li.firstChild);
        if (cut.nodeType === 3) {
          var at = cut.nodeValue.indexOf(' — ');
          k.appendChild(document.createTextNode(cut.nodeValue.slice(0, at)));
          cut.nodeValue = cut.nodeValue.slice(at + 3);
        } else {
          k.appendChild(cut);
        }
        while (li.firstChild) v.appendChild(li.firstChild);
        if (v.firstChild && v.firstChild.nodeType === 3) v.firstChild.nodeValue = v.firstChild.nodeValue.replace(/^\s*— /, '');
        li.appendChild(k);
        li.appendChild(v);
      });
    });

    // Claim-ledger results; tables scroll inside their own box.
    root.querySelectorAll('table').forEach(function (table) {
      var heads = Array.prototype.map.call(table.querySelectorAll('thead th'), function (th) { return th.textContent.trim(); });
      var col = heads.indexOf('Result');
      if (col < 0) col = heads.length - 1;
      table.querySelectorAll('tbody tr').forEach(function (tr) {
        var td = tr.children[col];
        var t = td ? td.textContent.trim() : '';
        if (/^reproduced/.test(t)) td.classList.add('ok');
        else if (/^failed/.test(t)) td.classList.add('bad');
        else if (/^not reproducible/.test(t)) td.classList.add('na');
      });
    });
    root.querySelectorAll('table').forEach(function (table) {
      var wrap = document.createElement('div');
      wrap.className = 'scroll';
      table.replaceWith(wrap);
      wrap.appendChild(table);
    });
  }
HTML
  cat <<'HTML'
  function button(cls, text, onclick) {
    var b = el('button', 'tool ' + cls, text);
    b.type = 'button';
    b.addEventListener('click', onclick);
    return b;
  }

  // Reference sections start collapsed; a contents link opens one. A triage
  // keeps Checked / Not checked open: what was not proven matters there.
  var collapse = kind === 'pr-triage' ? /^$/
    : kind === 'review-guide' ? /^(Skip|Hot files|Riskiest code)/
    : /^(Skip|Hot files|Riskiest code|Checked \/ Not checked)/;

  // One report into its page: the header band, the report's shapes, section
  // ids and contents. On a stack page an id starts with its tab's, so ids
  // stay unique across tabs.
  var taken = Object.create(null);
  taken['help-panel'] = 1; // added to the page after the tabs
  function build(t) {
    var page = t.page, prefix = t.id ? t.id + '-' : '';
    render(page, t.md);
    var top = header(page);
    marks(top);
    dress(page);

    // Section headings: an id and a contents link; "x — y" is a title and a
    // hint; the asks under "For a human" become callouts.
    var toc = el('nav', 'toc');
    all(page, 'h2').forEach(function (h2) {
      var label = h2.textContent.split(' — ')[0].trim();
      var base = prefix + (slug(label) || 'section'), id = base, k = 1;
      while (taken[id] || document.getElementById(id)) id = base + '-' + (++k);
      taken[id] = 1;
      h2.id = id;
      var a = el('a', '', label);
      a.href = '#' + h2.id;
      toc.appendChild(a);
      var t = h2.firstChild, at = t && t.nodeType === 3 ? t.nodeValue.indexOf(' — ') : -1;
      if (at > 0 && !t.nextSibling) {
        h2.appendChild(el('span', 'hint', t.nodeValue.slice(at + 3)));
        t.nodeValue = t.nodeValue.slice(0, at);
      }
      if (/^For a human/.test(label)) {
        for (var n = h2.nextElementSibling; n && n.tagName !== 'H2'; n = n.nextElementSibling) {
          if (n.tagName === 'P') n.classList.add('ask');
        }
      }
    });

    all(page, 'h2').forEach(function (h2) {
      if (!collapse.test(h2.textContent.trim())) return;
      var details = document.createElement('details');
      var summary = document.createElement('summary');
      details.id = h2.id;
      while (h2.firstChild) summary.appendChild(h2.firstChild);
      details.appendChild(summary);
      while (h2.nextSibling && !/^H[12]$/.test(h2.nextSibling.nodeName)) {
        details.appendChild(h2.nextSibling);
      }
      h2.replaceWith(details);
    });
    toc.addEventListener('click', function (e) {
      var target = e.target.hash && document.getElementById(e.target.hash.slice(1));
      if (target && target.tagName === 'DETAILS') target.open = true;
    });

    // A triage's claim ledger can hide the reproduced rows.
    if (kind === 'pr-triage') {
      all(page, '.scroll').forEach(function (wrap) {
        var rows = all(wrap, 'tbody tr');
        var ok = rows.filter(function (tr) { return tr.querySelector('td.ok'); });
        if (!ok.length || ok.length === rows.length) return;
        ok.forEach(function (tr) { tr.classList.add('ok-row'); });
        var label = 'Show only failed and not reproducible';
        var b = button('filter', label, function () {
          b.textContent = wrap.classList.toggle('only-open') ? 'Show all claims' : label;
        });
        wrap.parentNode.insertBefore(b, wrap);
      });
    }

    // A review guide's questions for the author copy as plain text.
    if (kind === 'review-guide') {
      all(page, 'dd.ask').forEach(function (dd) {
        var q = el('span', 'q');
        while (dd.firstChild) q.appendChild(dd.firstChild);
        dd.appendChild(q);
        var b = button('copy', 'Copy', function () {
          function done() {
            b.textContent = 'Copied';
            setTimeout(function () { b.textContent = 'Copy'; }, 1500);
          }
          function select() {
            var range = document.createRange(), sel = window.getSelection();
            range.selectNodeContents(q);
            sel.removeAllRanges();
            sel.addRange(range);
            b.textContent = 'Selected: press Ctrl/Cmd+C';
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(q.textContent.trim()).then(done, select);
          } else {
            select();
          }
        });
        dd.appendChild(b);
      });
    }
    t.top = top;
    t.toc = toc;
  }
  tabs.forEach(build);

HTML
  cat <<'HTML'
  // Help: the type's reading guide, behind a button in the header band. Its
  // examples are styled by the same code as the report.
  var panel = null;
  if (help) {
    panel = el('section', 'help');
    panel.id = 'help-panel';
    panel.hidden = true;
    panel.setAttribute('aria-label', 'How to read this page');
    var body = el('div', 'wrap');
    body.appendChild(el('div', 'eyebrow', 'How to read this page'));
    var guide = el('div');
    render(guide, help);
    dress(guide);
    // Each section's picture, by its heading's slug, after dress so its text
    // stays SVG. Only a template counts: a report heading can carry the same id.
    all(guide, 'h2').forEach(function (h2) {
      var pic = document.querySelector('template[id="help-pic-' + slug(h2.textContent) + '"]');
      if (pic) h2.after(pic.content.cloneNode(true));
    });
    all(guide, ':scope > p').forEach(function (p) {
      if (p.children.length !== 1 || p.firstElementChild.nodeName !== 'STRONG' || p.textContent.trim() !== 'Example') return;
      var box = el('div', 'sample');
      box.appendChild(el('div', 'eyebrow', 'Example'));
      while (p.nextSibling && p.nextSibling.nodeName !== 'H2') box.appendChild(p.nextSibling);
      p.replaceWith(box);
    });
    while (guide.firstChild) body.appendChild(guide.firstChild);
    panel.appendChild(body);
    var helpButton = button('help-button', 'Help', function () {
      panel.hidden = !panel.hidden;
      helpButton.setAttribute('aria-expanded', String(!panel.hidden));
      helpButton.textContent = panel.hidden ? 'Help' : 'Close help';
    });
    helpButton.setAttribute('aria-expanded', 'false');
    helpButton.setAttribute('aria-controls', 'help-panel');
    if (single) {
      var top = tabs[0].top, bar = el('div', 'bar');
      bar.appendChild(top.querySelector('.eyebrow') || el('span'));
      bar.appendChild(helpButton);
      top.insertBefore(bar, top.firstChild);
    }
  }

  tabs.forEach(function (t) {
    if (!t.top.children.length) return;
    if (t.toc.children.length > 2) t.top.appendChild(t.toc);
    var band = el('header', 'top');
    band.appendChild(t.top);
    t.page.parentNode.insertBefore(band, t.page);
  });
  // A stack page's tab bar: a link per tab, then Help.
  if (!single) {
    var nav = el('nav', 'tabs'), row = el('div', 'wrap');
    row.setAttribute('role', 'tablist');
    tabs.forEach(function (t) {
      t.link = el('a', '', t.label);
      t.link.href = '#' + t.id;
      t.link.setAttribute('role', 'tab');
      t.link.setAttribute('aria-controls', t.id);
      row.appendChild(t.link);
    });
    if (helpButton) row.appendChild(helpButton);
    nav.appendChild(row);
    document.body.insertBefore(nav, tabs[0].panel);
  }
  if (panel) document.body.insertBefore(panel, tabs[0].panel || tabs[0].page);

  // A page opened at, or moved to, a #section inside a collapsed box opens
  // it. On a stack page, #<tab> or a section in it shows that tab; any other
  // hash shows the Stack tab.
  function openHash() {
    var target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!single) {
      var shown = (target && target.closest('.tab-panel')) || tabs[0].panel;
      tabs.forEach(function (t) {
        t.panel.hidden = t.panel !== shown;
        t.link.setAttribute('aria-selected', String(t.panel === shown));
      });
      if (target === shown) window.scrollTo(0, 0);
      else if (target && shown.contains(target)) target.scrollIntoView();
    }
    var box = target && target.closest('details');
    if (box) { box.open = true; target.scrollIntoView(); }
  }
  window.addEventListener('hashchange', openHash);
  openHash();
})();
</script>
</body>
</html>
HTML
}

# valid FILE — an existing .md file, or a message on stderr.
valid() {
  if [[ "$1" != *.md ]]; then
    echo "render-report: $1: not a .md file" >&2
    return 1
  fi
  if [[ ! -f "$1" ]]; then
    echo "render-report: $1: no such file" >&2
    return 1
  fi
}

rc=0
if (( stack )); then
  for f in "$@"; do valid "$f" || rc=1; done
  (( rc == 0 )) || exit "$rc"
  out="${1%.md}.html"
  write_page "$(page_title "$1" | html_escape)" "$(page_kind "$1")" "$@" > "$out"
  echo "$out"
  exit 0
fi
for f in "$@"; do
  valid "$f" || { rc=1; continue; }
  out="${f%.md}.html"
  write_page "$(page_title "$f" | html_escape)" "$(page_kind "$f")" "$f" > "$out"
  echo "$out"
done
exit "$rc"
