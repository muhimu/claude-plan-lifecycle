#!/usr/bin/env bash
#
# render-report — write a styled, self-contained HTML view beside a report.
#
# For each <dir>/<name>.md it writes <dir>/<name>.html (overwriting it) and
# prints the path. The Markdown stays the source of truth: the page embeds it
# as base64 and renders it in the browser with a pinned marked.js, laying out
# a header band, verdict tiles, cards for decisions, findings and route stops,
# and collapsing reference sections. Raw HTML in the report shows as text.
# Without network the page shows the Markdown as plain text. Opens nothing.
#
# The report's folder picks the page type: review-guide/ is a review guide,
# triage/ a PR triage. Each type gets its own layout and a Help panel from the
# plugin's references/<type>-help.md; other reports get neither. A picture
# in references/<type>-help/<section>.svg sits under that Help section.
#
# With --stack, it writes one page for a stack instead: the first file is the
# Stack tab, each other file a slice tab in the order given, and the page is
# the first file's .html. A tab's id is its file name, so #62 opens 62.md's
# tab and #62-findings its Findings. The type and Help come from the first
# file's folder. Nothing is written when any input is bad.
#
# Usage:
#   render-report <file.md>...
#   render-report --stack <overview.md> <slice.md>...
#   render-report --help
#
# Exits 2 with no arguments or a --stack with fewer than two files, and 1 if
# any input is not an existing .md file; without --stack the valid ones are
# still rendered.

set -euo pipefail

# usage — the header comment above, from its name line to its last line.
usage() {
  awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
stack=0
if [[ "${1:-}" == "--stack" ]]; then
  stack=1
  shift
  if (( $# < 2 )); then
    usage >&2
    exit 2
  fi
fi
if (( $# == 0 )); then
  usage >&2
  exit 2
fi

# The plugin root, following symlinks: a linked checkout keeps its help files.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  link="$(readlink "$src")"
  if [[ "$link" == /* ]]; then src="$link"; else src="$(dirname "$src")/$link"; fi
done
plugin_root="$(cd "$(dirname "$src")/.." && pwd)"

# page_kind FILE — review-guide, pr-triage, or nothing, from the report's folder.
page_kind() {
  case "$(basename "$(dirname "$1")")" in
    review-guide) echo review-guide ;;
    triage) echo pr-triage ;;
  esac
}

# page_title FILE — two to four words from the report's directory and name.
page_title() {
  local name
  name="$(basename "$1" .md)"
  case "$(page_kind "$1")" in
    review-guide)
      if [[ "$name" == stack-* ]]; then
        echo "Review guide stack ${name#stack-}"
      else
        echo "Review guide #$name"
      fi
      ;;
    pr-triage)
      if [[ "$name" == stack-* ]]; then
        echo "Triage stack ${name#stack-}"
      else
        echo "Triage #$name"
      fi
      ;;
    *) echo "$name" ;;
  esac
}

html_escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# embed FILE — the file as one line of base64.
embed() {
  base64 < "$1" | tr -d '\n'
}

# write_page TITLE KIND FILE... — one file is a single page; with --stack,
# the files are the tabs, the first one the Stack tab.
