#!/usr/bin/env bash
#
# reap-plans — move merged and abandoned implementation plans into <plans-dir>/done/.
#
# Each plan is grouped by its frontmatter `slug:` (files sharing a slug form one
# unit — e.g. a design and its implementation plan). A group is reaped when the
# PR it names is MERGED on GitHub: `status: merged` is stamped into every
# frontmatter-bearing member, then the whole group moves to <plans-dir>/done/.
#
# Files without frontmatter are left untouched (add frontmatter per the
# plan-frontmatter skill to make them reapable). Groups with no PR are
# work-in-progress, never reaped. A group with any `status: abandoned` member
# moves to <plans-dir>/done/ as-is (no PR check, status left `abandoned`).
# A `-followups.md` stub shares its parent plan's slug and moves with it; the
# output names it on a `follow-ups` line so its open items get a look.
#
# Usage:
#   reap-plans            # run from a repo root (uses the repo's plans dir)
#   reap-plans -n         # dry run: show what would move, change nothing
#   reap-plans -d DIR     # override the plans dir
#
# The plans dir resolves -d > PLANS_DIR > `git config plans.dir` > local/plans.
#
# Requires: gh (authenticated), git, bash >= 4 (associative arrays).

set -euo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  echo "reap-plans: requires bash >= 4 (macOS ships 3.2 — brew install bash)" >&2
  exit 1
fi

dry_run=0
plans_dir=""

while getopts "nd:h" opt; do
  case "$opt" in
    n) dry_run=1 ;;
    d) plans_dir="$OPTARG" ;;
    h)
      sed -n '3,24p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "reap-plans: unknown option" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
if (( $# > 0 )); then
  echo "reap-plans: unexpected argument '$1' (to pick a plans dir, use -d DIR)" >&2
  exit 2
fi

if [[ -z "$plans_dir" ]]; then
  plans_dir="${PLANS_DIR:-$(git config --get plans.dir 2>/dev/null || true)}"
  plans_dir="${plans_dir:-local/plans}"
fi

if ! command -v gh >/dev/null 2>&1; then
  echo "reap-plans: 'gh' not found on PATH" >&2
  exit 1
fi

if [[ ! -d "$plans_dir" ]]; then
  echo "reap-plans: no such directory: $plans_dir (run from a repo root, or pass -d)" >&2
  exit 1
fi

done_dir="$plans_dir/done"

# has_frontmatter FILE — true if the file opens a YAML frontmatter block on
# line 1 ('---') AND closes it with a later '---'. A block that is opened but
# never closed is malformed and treated as NOT having frontmatter, so the
# file is ignored.
has_frontmatter() {
  awk '
    NR==1 { if ($0 != "---") exit 1; next }
    $0 == "---" { found=1; exit 0 }
    END { exit (found ? 0 : 1) }
  ' "$1"
}

# read_frontmatter FILE... — for each FILE with a closed frontmatter block,
# print FILE, slug, status and pr separated by the unit separator (\037), in
# one awk pass over all files (one process per field per file took seconds
# on a few dozen plans). The first line of each key wins. Values are trimmed
# and lose a matching pair of surrounding quotes (so `pr: "2405"` yields 2405,
# as YAML would parse it); `pr` also loses a leading '#', so `pr: 2346`,
# `pr: "2346"` and `pr: #2346` all yield `2346`.
read_frontmatter() {
  awk '
    FNR==1 { infm = ($0 == "---"); delete v; next }
    !infm  { next }
    $0 == "---" { printf "%s\037%s\037%s\037%s\n", FILENAME, v["slug"], v["status"], v["pr"]; infm=0; next }
    match($0, /^[[:space:]]*(slug|status|pr)[[:space:]]*:[[:space:]]*/) {
      key = $0; sub(/^[[:space:]]*/, "", key); sub(/[[:space:]]*:.*/, "", key)
      if (key in v) next
      val = substr($0, RLENGTH+1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      if (val ~ /^".*"$/ || val ~ /^'"'"'.*'"'"'$/) val = substr(val, 2, length(val)-2)
      if (key == "pr") sub(/^#/, "", val)
      v[key] = val
    }
  ' "$@"
}

# fetch_pr_states PR... — fill pr_states[PR] for every numeric PR with one
# GraphQL call (a `gh pr view` per PR costs about a second each). A number
# the call does not return is no PR: UNKNOWN. If the call itself fails,
# pr_states stays empty and pr_state looks each PR up on its own.
declare -A pr_states
fetch_pr_states() {
  local q="" n num state resp
  local -a nums=()
  for n in "$@"; do
    [[ "$n" =~ ^[0-9]+$ ]] || continue
    nums+=("$n")
    q+=" p$n:pullRequest(number:$n){state}"
  done
  [[ -n "$q" ]] || return 0
  resp="$(gh api graphql -F owner='{owner}' -F name='{repo}' -f query="query(\$owner:String!,\$name:String!){repository(owner:\$owner,name:\$name){$q}}" 2>/dev/null || true)"
  [[ "$resp" == *'"repository":{'* ]] || return 0
  for n in "${nums[@]}"; do pr_states["$n"]="UNKNOWN"; done
  while IFS=' ' read -r num state; do
    pr_states["$num"]="$state"
  done < <(grep -o '"p[0-9]*":{"state":"[A-Z]*"}' <<<"$resp" |
    sed 's/"p\([0-9]*\)":{"state":"\([A-Z]*\)"}/\1 \2/' || true)
}

# pr_state PR — echo the GitHub state of PR (MERGED/OPEN/CLOSED), or UNKNOWN.
pr_state() {
  if [[ -n "${pr_states[$1]:-}" ]]; then
    echo "${pr_states[$1]}"
    return
  fi
  gh pr view "$1" --json state --jq .state 2>/dev/null || echo "UNKNOWN"
}

shopt -s nullglob
plans=("$plans_dir"/*.md)
shopt -u nullglob

if (( ${#plans[@]} == 0 )); then
  echo "reap-plans: no plans in $plans_dir"
  exit 0
fi

declare -A file_group
declare -A group_pr
declare -A group_abandoned

# Frontmatter is authoritative. An empty `pr:` means "no PR yet" — there is no
# fallback to a body `PR:` line (prose may quote example PR numbers).
declare -A fm_slug fm_status fm_pr
while IFS=$'\037' read -r plan slug status pr; do
  fm_slug["$plan"]="$slug"
  fm_status["$plan"]="$status"
  fm_pr["$plan"]="$pr"
done < <(read_frontmatter "${plans[@]}")

for plan in "${plans[@]}"; do
  slug="${fm_slug[$plan]:-}"
  status="${fm_status[$plan]:-}"
  pr="${fm_pr[$plan]:-}"

  if [[ -n "$slug" ]]; then
    group_key="$slug"
  else
    group_key="solo:$plan"
  fi

  file_group["$plan"]="$group_key"

  if [[ -n "$pr" ]]; then
    if [[ -z "${group_pr[$group_key]:-}" ]]; then
      group_pr["$group_key"]="$pr"
    elif [[ "${group_pr[$group_key]}" != "$pr" ]]; then
      echo "warn: slug '$group_key' has conflicting PRs ${group_pr[$group_key]} and $pr; using ${group_pr[$group_key]}" >&2
    fi
  fi

  if [[ "$status" == "abandoned" ]]; then
    group_abandoned["$group_key"]=1
  fi
done

moved=0
skipped_no_pr=0
skipped_open=0

mapfile -t group_keys < <(printf '%s\n' "${file_group[@]}" | sort -u)

mapfile -t prs < <(for gk in "${group_keys[@]}"; do echo "${group_pr[$gk]:-}"; done | sort -u)
fetch_pr_states "${prs[@]}"

declare -a reap_groups=()
declare -A group_reason

for gk in "${group_keys[@]}"; do
  members=()
  for p in "${plans[@]}"; do
    [[ "${file_group[$p]}" == "$gk" ]] && members+=("$p")
  done
  label=""
  for m in "${members[@]}"; do label+="${m##*/} "; done
  label="${label% }"

  if [[ -n "${group_abandoned[$gk]:-}" ]]; then
    reap_groups+=("$gk")
    group_reason["$gk"]="abandoned"
    continue
  fi

  pr="${group_pr[$gk]:-}"
  if [[ -z "$pr" ]]; then
    echo "skip (no PR)   : $label"
    ((skipped_no_pr++)) || true
    continue
  fi

  state="$(pr_state "$pr")"
  if [[ "$state" != "MERGED" ]]; then
    echo "skip (PR #$pr $state) : $label"
    ((skipped_open++)) || true
    continue
  fi

  reap_groups+=("$gk")
  group_reason["$gk"]="PR #$pr merged"
done

# stamp_merged FILE — set `status: merged` in FILE's frontmatter in place,
# rewriting only the status line. No-op for files without frontmatter. Returns
# non-zero if the rewrite fails, so the caller can abort before moving a file
# that was not successfully stamped.
stamp_merged() {
  local file="$1" tmp
  has_frontmatter "$file" || return 0
  tmp="$(mktemp)"
  if ! awk '
    NR==1 && $0=="---" { infm=1; print; next }
    infm && $0=="---"  { infm=0; print; next }
    infm && /^[[:space:]]*status[[:space:]]*:/ { print "status: merged"; next }
    { print }
  ' "$file" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$file"
}

for gk in "${reap_groups[@]}"; do
  members=()
  for p in "${plans[@]}"; do
    [[ "${file_group[$p]}" == "$gk" ]] && members+=("$p")
  done
  reason="${group_reason[$gk]}"
  label=""
  for m in "${members[@]}"; do label+="${m##*/} "; done
  label="${label% }"

  # A follow-ups stub lists work nobody did; say so when it is archived.
  followups=""
  for m in "${members[@]}"; do
    [[ "$m" == *-followups.md ]] && followups+="  follow-ups (triage what is still open; the PR body's Follow-ups section is current): ${m##*/}"$'\n'
  done

  if (( dry_run )); then
    echo "would move ($reason) : $label -> $done_dir/"
    printf '%s' "$followups"
    moved=$(( moved + ${#members[@]} ))
    continue
  fi

  mkdir -p "$done_dir"
  for m in "${members[@]}"; do
    if [[ "$reason" != "abandoned" ]] && ! stamp_merged "$m"; then
      echo "error: failed to stamp 'status: merged' into ${m##*/}; not moving it" >&2
      continue
    fi
    mv "$m" "$done_dir/"
    moved=$(( moved + 1 ))
  done
  echo "moved ($reason)      : $label -> $done_dir/"
  printf '%s' "$followups"
done

echo "---"
if (( dry_run )); then
  echo "dry run: $moved would move, $skipped_open open/unknown, $skipped_no_pr without PR"
else
  echo "done: $moved moved, $skipped_open open/unknown, $skipped_no_pr without PR"
fi
