#!/usr/bin/env bash
#
# bin-wrapper — runs the installed plan-lifecycle plugin's copy of a script.
#
# Install one copy per script name; the name it is called by picks the script:
#   curl -fsSL https://raw.githubusercontent.com/muhimu/claude-plan-lifecycle/main/extras/bin-wrapper -o /tmp/bin-wrapper
#   for n in reap-plans stamp-plans link-plans render-report; do
#     install -m 755 /tmp/bin-wrapper ~/.local/bin/$n
#   done
#
# Each run reads the plugin's current installPath from installed_plugins.json,
# so the wrappers follow /plugin updates without being reinstalled. Copy it,
# don't symlink it: a link into the plugin cache would pin one build.

set -euo pipefail

name="$(basename "$0")"
# The installPath value is distinctive enough to match without parsing the JSON.
root="$(sed -n 's#.*"installPath": *"\([^"]*/claude-plan-lifecycle/plan-lifecycle/[^"]*\)".*#\1#p' \
  "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" 2>/dev/null | head -1 || true)"
if [ -z "$root" ]; then
  echo "$name: plan-lifecycle plugin not found in installed_plugins.json" >&2
  exit 1
fi
if [ ! -x "$root/bin/$name" ]; then
  echo "$name: no such script in the installed plugin ($root/bin)" >&2
  exit 1
fi
exec "$root/bin/$name" "$@"
